# Никогда не коммить реальные секреты.
BOT_TOKEN=
# Text AI defaults to Groq. For OpenAI switch AI_PROVIDER=openai and add
# OPENAI_API_KEY locally; never paste either API key into GitHub or chat.
AI_PROVIDER=groq
AI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Voice transcription stays on Groq Whisper, independent of text AI.
GROQ_STT_MODEL=whisper-large-v3-turbo

# HTTPS URL Mini App; на Railway может быть пустым (автоподхват RAILWAY_PUBLIC_DOMAIN).
WEB_APP_URL=

# Фронт использует тот же адрес, что и API. Поле оставь пустым.
# Только если API на другом домене, укажи его публичный HTTPS URL.
VITE_API_URL=

# Разрешённый origin API. В production лучше указать WEB_APP_URL.
CORS_ORIGIN=*

# Подключи persistent volume и укажи его путь в production.
DATA_DIR=server/data

# Локально можно оставить пустым: API покажет все тестовые записи.
# Для теста изоляции укажи свой Telegram user id.
LOOP_DEV_USER_ID=

# Безопасность и стоимость.
TELEGRAM_INIT_DATA_MAX_AGE=86400
BOT_RATE_LIMIT=20
API_RATE_LIMIT=120
SEARCH_RATE_LIMIT=30
MAX_AUDIO_SECONDS=600
REMINDER_GRACE_MINUTES=60
