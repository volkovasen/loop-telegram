# Никогда не коммить реальные секреты.
BOT_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Production HTTPS URL того же сервиса, например https://loop.example.com
WEB_APP_URL=

# В production фронт и API живут на одном origin, VITE_API_URL не нужен.
# Для отдельного API можно указать URL явно.
VITE_API_URL=http://localhost:8787

# Разрешённый origin API. В production лучше указать WEB_APP_URL.
CORS_ORIGIN=*

# Подключи persistent volume и укажи его путь в production.
DATA_DIR=server/data

# Локально можно оставить пустым: API покажет все тестовые записи.
# Для теста изоляции укажи свой Telegram user id.
LOOP_DEV_USER_ID=

# Безопасность и стоимость.
TELEGRAM_INIT_DATA_MAX_AGE=86400
BOT_RATE_LIMIT=20
API_RATE_LIMIT=120
SEARCH_RATE_LIMIT=30
MAX_AUDIO_SECONDS=600
REMINDER_GRACE_MINUTES=60
